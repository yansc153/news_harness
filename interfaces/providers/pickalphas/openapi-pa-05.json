{
  "info": {
    "title": "PickAlphas PA-05 upstream contract",
    "version": "1.0.0"
  },
  "openapi": "3.1.2",
  "paths": {
    "/reports/{reportId}/file": {
      "get": {
        "operationId": "pickalphas_citrini_report_pdf",
        "responses": {
          "200": {
            "description": "Authenticated response"
          },
          "307": {
            "description": "Anonymous page redirect to login"
          },
          "401": {
            "description": "Unauthenticated API response"
          },
          "403": {
            "description": "Unauthenticated or unauthorized data response"
          }
        },
        "x-huajiao-auth-profile": "pickalphas_session_cookie",
        "x-huajiao-observation-only": true
      }
    }
  },
  "servers": [
    {
      "url": "https://pickalphas.com"
    }
  ]
}
