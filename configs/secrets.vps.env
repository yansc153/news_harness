# VPS deployment: copy to /run/news-harness/news_harness.env
# Only the KPL discovery credential and Xueqiu browser state are used.
NEWS_HARNESS_KPL_DEVICE_ID_FILE=/run/news-harness/secrets/kpl-device-id
NEWS_HARNESS_XUEQIU_STORAGE_STATE_FILE=/run/news-harness/secrets/xueqiu-storage-state.json
NEWS_HARNESS_EXPORT_TOKEN_FILE=/run/news-harness/secrets/export-token
